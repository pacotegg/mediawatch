{
  "name": "tvwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "tv"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "scan": "npm run scan --workspace server",
    "build": "npm run build --workspace web && npm run build --workspace tv",
    "start": "npm run start --workspace server",
    "build:tv": "npm run build --workspace tv"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
