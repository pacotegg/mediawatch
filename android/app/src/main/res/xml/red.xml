<?xml version="1.0" encoding="utf-8"?>
<!--
  El servidor de casa habla HTTP a secas: es una máquina en la red local, sin
  nombre de dominio y sin certificado que valga. Desde Android 9 eso está
  prohibido salvo que se diga aquí expresamente.

  No se puede acotar por dirección porque la elige el usuario al conectar (y
  cambia si cambia el router), así que se permite en general. Lo que viaja por
  ahí no sale de la red de casa.

  Solo se confía en las CA del sistema (no en las que instale el usuario): el dominio de fuera lleva un certificado
  público, y una CA instalada a mano abriría la puerta a interceptar la sesión. (16/10/2026)
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
